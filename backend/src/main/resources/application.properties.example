# Example configuration template for WealthEdge Backend
spring.application.name=WealthEdge

spring.datasource.url=jdbc:mysql://localhost:3306/wealthedge?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=your_db_password

twelvedata.api.key=your_twelvedata_api_key
twelvedata.base-url=https://api.twelvedata.com

spring.security.oauth2.client.registration.google.client-id=your_google_client_id
spring.security.oauth2.client.registration.google.client-secret=your_google_client_secret
spring.security.oauth2.client.registration.google.scope=openid,profile,email

jwt.secret=your-super-secret-key-that-is-at-least-32-characters-long
jwt.expiration=86400000
